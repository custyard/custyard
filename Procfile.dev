# Overmind Procfile for development
# Usage: overmind start -f Procfile.dev

# Phoenix server with IEx shell
web: elixir --erl "+Bd" -S mix phx.server

# Asset watchers
tailwind: mix tailwind custyard --watch
esbuild: mix esbuild custyard --watch

# Note: LMTP server starts automatically via supervision tree when LMTP_ENABLED=true
# Note: IMAP channel pollers start with the app; connect mailboxes in the staff UI
#
# @see docs/lessons-learned/
