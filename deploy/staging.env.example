# Copy to .env.staging.local. Use with fly.staging.toml and the separate secrets file.
PHX_HOST=staging.custyard.com
PORT=4000
STORAGE_PROVIDER=fly
PROXY_PROVIDER=fly
DATABASE_PROVIDER=bunny
MAIL_ADAPTER=lettermint
EMAIL_FROM_ADDRESS=staging@custyard.com
EMAIL_FROM_NAME=Custyard Staging
EMAIL_NOTIFICATIONS_ENABLED=false
LMTP_ENABLED=false
SENTRY_ENVIRONMENT=staging
