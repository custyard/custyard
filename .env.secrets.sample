# Custyard Secrets (sensitive)
# Copy to .env.secrets and fill in values
# These values are synced to Fly.io via: mix fly.secrets --apply
#
# IMPORTANT: that task drops every line beginning with `#` (see
# lib/mix/tasks/fly.secrets.ex). A commented-out key is not "documented but
# optional" — it is invisible to the sync and will never be set on Fly. Keys
# that prod needs are left uncommented and empty; fill them in .env.secrets.
# Anything still commented below is a genuinely unused alternative.

# =============================================================================
# Core
# =============================================================================

SECRET_KEY_BASE=
# Optional; derived from SECRET_KEY_BASE when unset.
LIVE_VIEW_SIGNING_SALT=
# Database. Unset means the SQLite file at DATABASE_PATH on the mounted /data
# volume. For Turso, uncomment and set both (docs/ops/database.md#turso); a
# libsql:// URL without a token refuses to boot.
# DATABASE_URL=libsql://custyard-<org>.turso.io
# TURSO_AUTH_TOKEN=
# For a release compiled with Ecto.Adapters.Postgres instead:
# DATABASE_URL=postgres://user:password@host/database
# INSTANCE_ADMIN_EMAIL is deliberately not listed: set it once with
# `fly secrets set INSTANCE_ADMIN_EMAIL=you@example.com` to create the first installation administrator
# on the next boot, then `fly secrets unset INSTANCE_ADMIN_EMAIL` after the first login.
# A key here would be set again by every `mix fly.secrets --apply`.

# Tenant acknowledgment broker credentials are encrypted database settings,
# configured at /app/settings/integrations.

# =============================================================================
# Email Credentials
# =============================================================================

# Encryption key for stored IMAP channel passwords: openssl rand -base64 32
# CREDENTIAL_ENCRYPTION_KEY=
# Previous key, only while rotating
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# Mailgun
# MAILGUN_API_KEY=key-xxx

# SendGrid
# SENDGRID_API_KEY=SG.xxx

# SMTP
# SMTP_PASSWORD=

# Lettermint system authentication mail (MAIL_ADAPTER=lettermint).
# Tenant support credentials are stored separately in /app/settings/email.
LETTERMINT_PROJECT_TOKEN=
LETTERMINT_API_URL=

# =============================================================================
# Error Tracking (self-hosted Sentry at catch.onetimesecret.com)
# =============================================================================

# Enables Sentry in production only (unset => disabled). The public key in a
# DSN is client-embeddable by design; it is kept here (a Fly secret rather than
# checked-in fly.toml) so it stays out of git and can be rotated/disabled.
# The concrete value for this project lives in docs/ops/sentry.md.
#
# Uncommented on purpose: `mix fly.secrets --apply` skips every line starting
# with `#`, so while this key sat commented it was never synced — which is why
# prod has been running with Sentry silently off. An empty value is safe;
# config/runtime.exs maps "" to nil and the SDK stays disabled.
SENTRY_DSN=

# Inbound and delivery-status webhook secrets are encrypted tenant records.
