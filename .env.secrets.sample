# Custyard Secrets (sensitive)
# Copy to .env.secrets and fill in values
# These values are synced to Fly.io via: mix fly.secrets --apply

# =============================================================================
# Core (required in production)
# =============================================================================

SECRET_KEY_BASE=
LIVE_VIEW_SIGNING_SALT=
DATABASE_URL=
# OPERATOR_PASSWORD is no longer needed — operators authenticate via email magic link

# =============================================================================
# Email Credentials
# =============================================================================

# IMAP
# IMAP_PASSWORD=

# Mailgun
# MAILGUN_API_KEY=key-xxx

# SendGrid
# SENDGRID_API_KEY=SG.xxx

# SMTP
# SMTP_PASSWORD=

# Lettermint
# LETTERMINT_API_KEY=your-api-token

# =============================================================================
# Webhook Signature Verification (per-source secrets for inbound)
# =============================================================================

# WEBHOOK_SECRET_LETTERMINT=your-lettermint-signing-secret
# WEBHOOK_SECRET_ZENDESK=your-zendesk-signing-secret
# WEBHOOK_SECRET_INTERCOM=your-intercom-signing-secret
# WEBHOOK_SECRET_SLACK=your-slack-signing-secret
