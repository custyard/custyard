#!/bin/sh

# Release runtime configuration.
# See https://hexdocs.pm/mix/Mix.Tasks.Release.html#module-vm-args-and-env-sh-eex

# Configure Erlang distribution (node connectivity).
# RELEASE_DISTRIBUTION must be "sname" (short), "name" (long), or "none" (default).
: "${RELEASE_DISTRIBUTION:=none}"; export RELEASE_DISTRIBUTION
