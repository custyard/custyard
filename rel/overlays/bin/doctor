#!/bin/sh
# Boot report and database probe; full usage comes from `doctor help`.
set -eu
bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

# `fly ssh console` runs as root, but the app runs as custyard. Run as root on a
# fresh volume, a probe would create a root-owned database the app cannot write.
if [ "$(id -u)" = "0" ]; then
  if id custyard >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
    exec runuser -u custyard -- "$bin_dir/doctor" "$@"
  fi
  echo "doctor: refusing to run as root; run as the user that owns the database" >&2
  exit 1
fi

exec "$bin_dir/custyard" eval 'Custyard.Release.doctor_cli(System.argv())' "$@"
