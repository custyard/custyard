#!/bin/sh
# Data subject requests: export, erase, erase-contact; full usage comes from `dsar help`.
set -eu
bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

# `fly ssh console` runs as root, but the app runs as custyard. Run as root on a
# fresh volume, a command would create a root-owned database the app cannot write.
if [ "$(id -u)" = "0" ]; then
  if id custyard >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
    exec runuser -u custyard -- "$bin_dir/dsar" "$@"
  fi
  echo "dsar: refusing to run as root; run as the user that owns the database" >&2
  exit 1
fi

exec "$bin_dir/custyard" eval 'Custyard.Release.dsar_cli(System.argv())' "$@"
