#!/bin/sh
# File-volume initialization and recovery; run only while the app is stopped.
set -eu
bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

if [ "$(id -u)" = "0" ]; then
  if id custyard >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
    exec runuser -u custyard -- "$bin_dir/data-volume" "$@"
  fi
  echo "data-volume: refusing root; run as the container's custyard user" >&2
  exit 1
fi

exec "$bin_dir/custyard" eval 'case Custyard.Release.Volume.main(System.argv()) do :error -> System.halt(1); _ -> :ok end' "$@"
