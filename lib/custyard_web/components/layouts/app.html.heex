<header class="px-4 sm:px-6 lg:px-8" data-testid="layout-header">
  <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/" data-testid="layout-logo">
        <span class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Custyard</span>
      </a>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900 dark:text-zinc-100">
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8" data-testid="layout-main">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
