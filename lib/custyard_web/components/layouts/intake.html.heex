<%!-- Sparse app layout for the public intake surfaces: instance name
     (fallback "Custyard"), optional logo, primary-color accent — nothing
     else. Guarded against a missing :branding assign so error renders
     inside the pipeline never crash. --%>
<% branding = assigns[:branding] || %{name: nil, logo_url: nil, primary_color: nil} %>
<div class="min-h-screen bg-white dark:bg-zinc-900" data-testid="intake-layout">
  <header
    class="border-b-2 border-zinc-100 dark:border-zinc-800 px-4 py-4 sm:px-6"
    style={branding.primary_color && "border-bottom-color: #{branding.primary_color}"}
    data-testid="intake-header"
  >
    <div class="mx-auto flex max-w-2xl items-center gap-3">
      <img
        :if={branding.logo_url}
        src={branding.logo_url}
        alt=""
        class="h-8 w-auto"
        data-testid="intake-logo"
      />
      <span
        class="text-lg font-semibold text-zinc-900 dark:text-zinc-100"
        data-testid="intake-instance-name"
      >
        {branding.name || "Custyard"}
      </span>
    </div>
  </header>
  <main class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-2xl">
      <.flash_group flash={@flash} />
      {@inner_content}
    </div>
  </main>
</div>
