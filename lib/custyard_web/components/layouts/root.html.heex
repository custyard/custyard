<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content="Customer service and support platform" />
    <%!-- Theme & browser chrome --%>
    <meta name="theme-color" content="#FD4F00" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#18181B" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={assigns[:site_name] || "Custyard"} />
    <meta name="application-name" content={assigns[:site_name] || "Custyard"} />
    <%!-- Open Graph --%>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={assigns[:site_name] || "Custyard"} />
    <meta property="og:title" content={assigns[:page_title] || assigns[:site_name] || "Custyard"} />
    <meta property="og:description" content="Customer service and support platform" />
    <meta property="og:image" content={~p"/images/og-image.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Custyard — Customer service and support platform" />
    <%!-- Twitter Card --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={assigns[:page_title] || assigns[:site_name] || "Custyard"}
    />
    <meta name="twitter:description" content="Customer service and support platform" />
    <meta name="twitter:image" content={~p"/images/og-image.png"} />
    <meta name="twitter:image:alt" content="Custyard — Customer service and support platform" />
    <.live_title suffix={" · " <> (assigns[:site_name] || "Custyard")}>
      {assigns[:page_title] || assigns[:site_name] || "Custyard"}
    </.live_title>
    <%!-- Favicon & icons --%>
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link rel="manifest" href="/site.webmanifest" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-white dark:bg-zinc-900 antialiased" data-testid="layout-body">
    {@inner_content}
  </body>
</html>
