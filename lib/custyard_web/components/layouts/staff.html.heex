<%!-- Helper to determine if a nav link is active --%>
<% # Get current path from socket URI or assigns
current_path =
  case assigns do
    %{socket: %{host_uri: %{path: path}}} when is_binary(path) -> path
    # LiveView - use live_action instead
    %{live_action: _} -> nil
    _ -> nil
  end

# Check if current view matches the nav item
# For LiveViews, we can check the view module
current_view = assigns[:socket] && assigns.socket.view

nav_active? = fn target_path, target_views ->
  path_match = current_path && String.starts_with?(current_path, target_path)
  view_match = is_list(target_views) && current_view in target_views
  path_match || view_match
end

active_class =
  "text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 px-2 py-1 rounded-md border-b-2 border-indigo-600 dark:border-indigo-400"

inactive_class =
  "text-sm text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200 px-2 py-1 rounded-md hover:bg-gray-50 dark:hover:bg-zinc-800" %>
<div class="h-screen flex flex-col bg-gray-100 dark:bg-zinc-900" data-testid="staff-layout">
  <%!-- Top nav --%>
  <div
    class="bg-white dark:bg-zinc-800 border-b border-gray-200 dark:border-zinc-700 px-4 py-2"
    data-testid="staff-layout-nav"
  >
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <span class="font-bold text-gray-900 dark:text-zinc-100 text-sm tracking-tight">
          {if assigns[:current_tenant],
            do: @current_tenant.name,
            else: "Custyard"}
        </span>
        <span :if={assigns[:current_staff]} data-testid="staff-identity" class="text-sm">Staff · {@current_staff.email}</span>
        <span class="hidden md:inline text-gray-300 dark:text-zinc-600">|</span>
        <%!-- Desktop nav links - hidden on mobile --%>
        <nav class="hidden md:flex items-center gap-4">
          <.link
            navigate={~p"/app"}
            class={
              if nav_active?.("/app", [CustyardWeb.Staff.AttentionQueueLive]) &&
                   !nav_active?.("/app/", []),
                 do: active_class,
                 else: inactive_class
            }
            data-testid="staff-nav-queue"
          >
            Attention Queue
          </.link>
          <.link
            navigate={~p"/app/neglect"}
            class={
              if nav_active?.("/app/neglect", [CustyardWeb.Staff.NeglectReportLive]),
                do: active_class,
                else: inactive_class
            }
            data-testid="staff-nav-neglect"
          >
            Neglect Report
          </.link>
          <.link
            navigate={~p"/app/customers"}
            class={
              if nav_active?.("/app/customers", [
                   CustyardWeb.Staff.OrganizationsLive,
                   CustyardWeb.Staff.OrganizationDetailLive
                 ]),
                 do: active_class,
                 else: inactive_class
            }
            data-testid="staff-nav-orgs"
          >
            Customers
          </.link>
          <.link
            navigate={~p"/app/projects"}
            class={
              if nav_active?.("/app/projects", [CustyardWeb.Staff.ProjectsLive]),
                do: active_class,
                else: inactive_class
            }
            data-testid="staff-nav-projects"
          >
            Projects
          </.link>
          <.link
            navigate={~p"/app/settings/intake"}
            class={
              if nav_active?.("/app/settings/intake", [
                   CustyardWeb.Staff.IntakeSourcesLive
                 ]),
                 do: active_class,
                 else: inactive_class
            }
            data-testid="staff-nav-intake-sources"
          >
            Intake Sources
          </.link>
          <.link
            navigate={~p"/app/settings/slugs"}
            class={
              if nav_active?.("/app/settings/slugs", [CustyardWeb.Staff.SlugsLive]),
                do: active_class,
                else: inactive_class
            }
            data-testid="staff-nav-slugs"
          >
            Slugs
          </.link>
          <.link
            navigate={~p"/app/settings/integrations"}
            class={
              if nav_active?.("/app/settings/integrations", [
                   CustyardWeb.Staff.AcknowledgmentsLive
                 ]),
                 do: active_class,
                 else: inactive_class
            }
            data-testid="staff-nav-acknowledgments"
          >
            Acknowledgments
          </.link>
          <.link
            navigate={~p"/app/settings/workflow"}
            class={
              if nav_active?.("/app/settings/workflow", [CustyardWeb.Staff.SettingsLive]),
                do: active_class,
                else: inactive_class
            }
            data-testid="staff-nav-settings"
          >
            Settings
          </.link>
        </nav>
      </div>
      <%!-- Desktop logout - hidden on mobile --%>
      <div class="hidden md:block">
        <.link href={CustyardWeb.Endpoint.url() <> "/admin/login"} class="text-xs mr-3">Instance admin sign in</.link>
        <.link
          href={~p"/app/logout"}
          method="delete"
          class="text-sm text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200"
          data-testid="staff-nav-logout"
        >
          Log out
        </.link>
      </div>
      <%!-- Mobile menu button --%>
      <button
        type="button"
        class="md:hidden p-2 text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200"
        phx-click={JS.toggle(to: "#mobile-menu")}
        aria-label="Toggle navigation menu"
        data-testid="staff-nav-mobile-toggle"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>
    <%!-- Mobile menu - hidden by default, toggled by button --%>
    <nav
      id="mobile-menu"
      class="hidden md:hidden mt-2 pb-2 border-t border-gray-200 dark:border-zinc-700 pt-2 flex flex-col gap-2"
    >
      <.link
        navigate={~p"/app"}
        class={
          if nav_active?.("/app", [CustyardWeb.Staff.AttentionQueueLive]) &&
               !nav_active?.("/app/", []),
             do: active_class,
             else: inactive_class
        }
      >
        Attention Queue
      </.link>
      <.link
        navigate={~p"/app/neglect"}
        class={
          if nav_active?.("/app/neglect", [CustyardWeb.Staff.NeglectReportLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Neglect Report
      </.link>
      <.link
        navigate={~p"/app/customers"}
        class={
          if nav_active?.("/app/customers", [
               CustyardWeb.Staff.OrganizationsLive,
               CustyardWeb.Staff.OrganizationDetailLive
             ]),
             do: active_class,
             else: inactive_class
        }
      >
        Customers
      </.link>
      <.link
        navigate={~p"/app/projects"}
        class={
          if nav_active?.("/app/projects", [CustyardWeb.Staff.ProjectsLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Projects
      </.link>
      <.link
        navigate={~p"/app/settings/intake"}
        class={
          if nav_active?.("/app/settings/intake", [
               CustyardWeb.Staff.IntakeSourcesLive
             ]),
             do: active_class,
             else: inactive_class
        }
      >
        Intake Sources
      </.link>
      <.link
        navigate={~p"/app/settings/slugs"}
        class={
          if nav_active?.("/app/settings/slugs", [CustyardWeb.Staff.SlugsLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Slugs
      </.link>
      <.link
        navigate={~p"/app/settings/integrations"}
        class={
          if nav_active?.("/app/settings/integrations", [CustyardWeb.Staff.AcknowledgmentsLive]) do
            active_class
          else
            inactive_class
          end
        }
        data-testid="staff-nav-mobile-acknowledgments"
      >
        Acknowledgments
      </.link>
      <.link
        navigate={~p"/app/settings/workflow"}
        class={
          if nav_active?.("/app/settings/workflow", [CustyardWeb.Staff.SettingsLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Settings
      </.link>
      <.link
        href={~p"/app/logout"}
        method="delete"
        class="text-sm text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200"
      >
        Log out
      </.link>
    </nav>
  </div>

  <%!-- Flash messages --%>
  <.flash_group flash={@flash} />

  <div :if={assigns[:current_tenant]} class="px-4 py-2 flex flex-wrap gap-4 text-sm border-b">
    <.link
      :if={assigns[:current_role] == "admin"}
      navigate={~p"/app/settings/email"}
      class="text-indigo-600 dark:text-indigo-400"
    >Support email setup</.link>
    <.link
      :if={assigns[:current_role] == "admin"}
      navigate={~p"/app/settings/workspace"}
      class="text-indigo-600 dark:text-indigo-400"
    >Tenant settings</.link>
  </div>

  <%!-- Content --%>
  <div class="flex-1 min-h-0 flex flex-col overflow-y-auto" data-testid="staff-layout-content">
    {@inner_content}
  </div>
</div>
