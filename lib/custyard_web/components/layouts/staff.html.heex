<%!-- Helper to determine if a nav link is active --%>
<% # Get current path from socket URI or assigns
current_path =
  case assigns do
    %{socket: %{host_uri: %{path: path}}} when is_binary(path) -> path
    # LiveView - use live_action instead
    %{live_action: _} -> nil
    _ -> nil
  end

# Check if current view matches the nav item
# For LiveViews, we can check the view module
current_view = assigns[:socket] && assigns.socket.view

nav_active? = fn target_path, target_views ->
  path_match = current_path && String.starts_with?(current_path, target_path)
  view_match = is_list(target_views) && current_view in target_views
  path_match || view_match
end

# Link labels never break; when the row is too narrow the links wrap whole.
active_class =
  "whitespace-nowrap text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 px-2 py-1 rounded-md border-b-2 border-indigo-600 dark:border-indigo-400"

inactive_class =
  "whitespace-nowrap text-sm text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200 px-2 py-1 rounded-md hover:bg-gray-50 dark:hover:bg-zinc-800" %>
<div class="h-screen flex flex-col bg-gray-100 dark:bg-zinc-900" data-testid="staff-layout">
  <%!-- Top nav --%>
  <div
    class="bg-white dark:bg-zinc-800 border-b border-gray-200 dark:border-zinc-700 px-4 py-2"
    data-testid="staff-layout-nav"
  >
    <%!-- One row from 1280px up: workspace name, destinations, then the
    account group (who is signed in, instance admin, log out) at the end.
    From md to 1280px the destinations take a row of their own beneath, and
    below md they move into the menu. Link labels never break. --%>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span
        class="max-w-[45%] shrink-0 truncate font-bold text-gray-900 dark:text-zinc-100 text-sm tracking-tight md:max-w-[12rem]"
        title={if assigns[:current_tenant], do: @current_tenant.name, else: "Custyard"}
      >
        {if assigns[:current_tenant],
          do: @current_tenant.name,
          else: "Custyard"}
      </span>
      <%!-- Desktop nav links - hidden on mobile --%>
      <nav
        class="hidden items-center gap-x-0.5 gap-y-1 md:order-last md:flex md:w-full md:flex-wrap xl:order-none xl:w-auto xl:flex-none xl:flex-nowrap"
        aria-label="Staff"
      >
        <.link
          navigate={~p"/app"}
          class={
            if nav_active?.("/app", [CustyardWeb.Staff.AttentionQueueLive]) &&
                 !nav_active?.("/app/", []),
               do: active_class,
               else: inactive_class
          }
          data-testid="staff-nav-queue"
        >
          Attention Queue
        </.link>
        <.link
          navigate={~p"/app/neglect"}
          class={
            if nav_active?.("/app/neglect", [CustyardWeb.Staff.NeglectReportLive]),
              do: active_class,
              else: inactive_class
          }
          data-testid="staff-nav-neglect"
        >
          Neglect Report
        </.link>
        <.link
          navigate={~p"/app/customers"}
          class={
            if nav_active?.("/app/customers", [
                 CustyardWeb.Staff.OrganizationsLive,
                 CustyardWeb.Staff.OrganizationDetailLive
               ]),
               do: active_class,
               else: inactive_class
          }
          data-testid="staff-nav-orgs"
        >
          Customers
        </.link>
        <.link
          navigate={~p"/app/projects"}
          class={
            if nav_active?.("/app/projects", [CustyardWeb.Staff.ProjectsLive]),
              do: active_class,
              else: inactive_class
          }
          data-testid="staff-nav-projects"
        >
          Projects
        </.link>
        <.link
          navigate={~p"/app/settings/intake"}
          class={
            if nav_active?.("/app/settings/intake", [
                 CustyardWeb.Staff.IntakeSourcesLive
               ]),
               do: active_class,
               else: inactive_class
          }
          data-testid="staff-nav-intake-sources"
        >
          Intake Sources
        </.link>
        <.link
          navigate={~p"/app/settings/slugs"}
          class={
            if nav_active?.("/app/settings/slugs", [CustyardWeb.Staff.SlugsLive]),
              do: active_class,
              else: inactive_class
          }
          data-testid="staff-nav-slugs"
        >
          Slugs
        </.link>
        <.link
          navigate={~p"/app/settings/integrations"}
          class={
            if nav_active?.("/app/settings/integrations", [
                 CustyardWeb.Staff.AcknowledgmentsLive
               ]),
               do: active_class,
               else: inactive_class
          }
          data-testid="staff-nav-acknowledgments"
        >
          Acknowledgments
        </.link>
        <.link
          navigate={~p"/app/settings/workflow"}
          class={
            if nav_active?.("/app/settings/workflow", [CustyardWeb.Staff.SettingsLive]),
              do: active_class,
              else: inactive_class
          }
          data-testid="staff-nav-settings"
        >
          Settings
        </.link>
      </nav>
      <%!-- Account group. The address shortens before anything wraps. --%>
      <div class="ml-auto flex min-w-0 flex-1 items-center justify-end gap-x-1">
        <span
          :if={assigns[:current_staff]}
          data-testid="staff-identity"
          class="min-w-0 truncate text-sm text-gray-700 dark:text-zinc-200"
          title={"Signed in as staff: #{@current_staff.email}"}
        >Staff · {@current_staff.email}</span>
        <%!-- Desktop only: the mobile menu carries these two. The admin
        link is an icon below 1536px; its name stays the same for assistive
        technology and as the tooltip. --%>
        <.link
          href={CustyardWeb.Endpoint.url() <> "/admin/login"}
          class="hidden shrink-0 items-center gap-1 rounded-md px-1.5 py-1 text-xs text-gray-600 hover:bg-gray-50 hover:text-gray-700 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-200 md:inline-flex"
          title="Instance admin sign in"
          data-testid="staff-nav-instance-admin"
        >
          <.icon name="hero-shield-check-mini" class="h-4 w-4" />
          <span class="sr-only 2xl:not-sr-only">Instance admin sign in</span>
        </.link>
        <.link
          href={~p"/app/logout"}
          method="delete"
          class="hidden shrink-0 whitespace-nowrap rounded-md px-1.5 py-1 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-700 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-200 md:inline"
          data-testid="staff-nav-logout"
        >
          Log out
        </.link>
        <%!-- Mobile menu button --%>
        <button
          type="button"
          class="md:hidden shrink-0 p-2 text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200"
          phx-click={JS.toggle(to: "#mobile-menu")}
          aria-label="Toggle navigation menu"
          data-testid="staff-nav-mobile-toggle"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
    </div>
    <%!-- Mobile menu - hidden by default, toggled by button --%>
    <nav
      id="mobile-menu"
      class="hidden md:hidden mt-2 pb-2 border-t border-gray-200 dark:border-zinc-700 pt-2 flex flex-col gap-2"
    >
      <.link
        navigate={~p"/app"}
        class={
          if nav_active?.("/app", [CustyardWeb.Staff.AttentionQueueLive]) &&
               !nav_active?.("/app/", []),
             do: active_class,
             else: inactive_class
        }
      >
        Attention Queue
      </.link>
      <.link
        navigate={~p"/app/neglect"}
        class={
          if nav_active?.("/app/neglect", [CustyardWeb.Staff.NeglectReportLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Neglect Report
      </.link>
      <.link
        navigate={~p"/app/customers"}
        class={
          if nav_active?.("/app/customers", [
               CustyardWeb.Staff.OrganizationsLive,
               CustyardWeb.Staff.OrganizationDetailLive
             ]),
             do: active_class,
             else: inactive_class
        }
      >
        Customers
      </.link>
      <.link
        navigate={~p"/app/projects"}
        class={
          if nav_active?.("/app/projects", [CustyardWeb.Staff.ProjectsLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Projects
      </.link>
      <.link
        navigate={~p"/app/settings/intake"}
        class={
          if nav_active?.("/app/settings/intake", [
               CustyardWeb.Staff.IntakeSourcesLive
             ]),
             do: active_class,
             else: inactive_class
        }
      >
        Intake Sources
      </.link>
      <.link
        navigate={~p"/app/settings/slugs"}
        class={
          if nav_active?.("/app/settings/slugs", [CustyardWeb.Staff.SlugsLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Slugs
      </.link>
      <.link
        navigate={~p"/app/settings/integrations"}
        class={
          if nav_active?.("/app/settings/integrations", [CustyardWeb.Staff.AcknowledgmentsLive]) do
            active_class
          else
            inactive_class
          end
        }
        data-testid="staff-nav-mobile-acknowledgments"
      >
        Acknowledgments
      </.link>
      <.link
        navigate={~p"/app/settings/workflow"}
        class={
          if nav_active?.("/app/settings/workflow", [CustyardWeb.Staff.SettingsLive]),
            do: active_class,
            else: inactive_class
        }
      >
        Settings
      </.link>
      <.link
        href={CustyardWeb.Endpoint.url() <> "/admin/login"}
        class="text-sm text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200 px-2 py-1"
        data-testid="staff-nav-mobile-instance-admin"
      >
        Instance admin sign in
      </.link>
      <.link
        href={~p"/app/logout"}
        method="delete"
        class="text-sm text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200 px-2 py-1"
      >
        Log out
      </.link>
    </nav>
  </div>

  <%!-- Flash messages --%>
  <.flash_group flash={@flash} />

  <div :if={assigns[:current_tenant]} class="px-4 py-2 flex flex-wrap gap-4 text-sm border-b">
    <.link
      :if={assigns[:current_role] == "admin"}
      navigate={~p"/app/settings/email"}
      class="text-indigo-600 dark:text-indigo-400"
    >Support email setup</.link>
    <.link
      :if={assigns[:current_role] == "admin"}
      navigate={~p"/app/settings/workspace"}
      class="text-indigo-600 dark:text-indigo-400"
    >Tenant settings</.link>
  </div>

  <%!-- Content --%>
  <div class="flex-1 min-h-0 flex flex-col overflow-y-auto" data-testid="staff-layout-content">
    {@inner_content}
  </div>
</div>
