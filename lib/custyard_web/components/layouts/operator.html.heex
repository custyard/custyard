<div class="h-screen flex flex-col bg-gray-100">
  <%!-- Top nav --%>
  <div class="bg-white border-b border-gray-200 px-4 py-2 flex items-center gap-4">
    <span class="font-bold text-gray-900 text-sm tracking-tight">Service Platform</span>
    <span class="text-gray-300">|</span>
    <.link navigate={~p"/operator"} class="text-sm text-gray-500 hover:text-gray-700">
      Attention Queue
    </.link>
    <.link navigate={~p"/operator/neglect"} class="text-sm text-gray-500 hover:text-gray-700">
      Neglect Report
    </.link>
    <.link
      navigate={~p"/operator/organizations"}
      class="text-sm text-gray-500 hover:text-gray-700"
    >
      Organizations
    </.link>
    <.link navigate={~p"/operator/settings"} class="text-sm text-gray-500 hover:text-gray-700">
      Settings
    </.link>
    <div class="ml-auto">
      <.link
        href={~p"/operator/logout"}
        method="delete"
        class="text-sm text-gray-500 hover:text-gray-700"
      >
        Log out
      </.link>
    </div>
  </div>

  <%!-- Flash messages --%>
  <.flash_group flash={@flash} />

  <%!-- Content --%>
  <div class="flex-1 overflow-hidden">
    {@inner_content}
  </div>
</div>
