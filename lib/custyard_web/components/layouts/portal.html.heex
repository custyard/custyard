<%!-- Helper to determine if a nav link is active --%>
<% # Get current view module for LiveView pages
current_view = assigns[:socket] && assigns.socket.view

# Check if current view matches target views
nav_active? = fn target_views ->
  is_list(target_views) && current_view in target_views
end

active_class =
  "text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 px-2 py-1 rounded-md border-b-2 border-indigo-600 dark:border-indigo-400"

inactive_class =
  "text-sm text-gray-600 hover:text-gray-700 dark:text-zinc-300 dark:hover:text-zinc-200 px-2 py-1 rounded-md hover:bg-gray-50 dark:hover:bg-zinc-800" %>
<div class="h-screen flex flex-col bg-gray-100 dark:bg-zinc-900" data-testid="portal-layout">
  <%!-- Top nav --%>
  <div
    class="bg-white dark:bg-zinc-800 border-b border-gray-200 dark:border-zinc-700 px-4 py-2 flex items-center gap-4"
    data-testid="portal-layout-nav"
  >
    <%= if assigns[:current_org] && @current_org.logo_url do %>
      <img
        src={@current_org.logo_url}
        alt={"#{@current_org.name} logo"}
        class="h-6 w-auto"
        data-testid="portal-nav-logo"
      />
    <% end %>
    <span
      class="font-bold text-gray-900 dark:text-zinc-100 text-sm tracking-tight"
      style={
        if assigns[:current_org] && @current_org.primary_color,
          do: "color: #{@current_org.primary_color}",
          else: nil
      }
    >
      <%= if assigns[:current_org] && @current_org.name do %>
        {@current_org.name}
      <% else %>
        Support Portal
      <% end %>
    </span>
    <span class="text-gray-300 dark:text-zinc-600">|</span>
    <.link
      navigate={@portal_home_path}
      class={
        if nav_active?.([
             CustyardWeb.Portal.RequestListLive,
             CustyardWeb.Portal.ConversationLive,
             CustyardWeb.Portal.NewRequestLive
           ]),
           do: active_class,
           else: inactive_class
      }
      data-testid="portal-nav-requests"
    >
      Requests
    </.link>
    <.link
      navigate={"#{@portal_path}/projects"}
      class={
        if nav_active?.([CustyardWeb.Portal.ProjectsListLive, CustyardWeb.Portal.ProjectLive]),
          do: active_class,
          else: inactive_class
      }
      data-testid="portal-nav-projects"
    >
      Projects
    </.link>
    <div class="ml-auto">
      <.link
        navigate={"#{@portal_path}/new"}
        class="text-sm font-medium text-white px-4 py-2 rounded-lg shadow-sm hover:opacity-90 transition-opacity"
        style={
          if assigns[:current_org] && @current_org.primary_color do
            "background-color: #{@current_org.primary_color}"
          else
            "background-color: #4f46e5"
          end
        }
        data-testid="portal-nav-new-request"
      >
        New Request
      </.link>
    </div>
  </div>

  <%!-- Flash messages --%>
  <.flash_group flash={@flash} />

  <%!-- Content --%>
  <div class="flex-1 overflow-auto" data-testid="portal-layout-content">
    {@inner_content}
  </div>
</div>
