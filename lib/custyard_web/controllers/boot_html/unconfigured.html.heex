<%!-- Public while the instance is unconfigured: variable names and shapes only.
     The one generated value is the fresh SECRET_KEY_BASE from Boot.Report. --%>
<div
  class="rounded-lg border border-zinc-200 bg-white p-8 shadow-sm dark:border-zinc-700 dark:bg-zinc-800"
  data-testid="boot-card-unconfigured"
>
  <h1 class="text-xl font-semibold">Custyard is not configured yet</h1>
  <p class="mt-2 text-zinc-600 dark:text-zinc-400">
    This instance started without the settings it needs. Nothing has been written.
    Set these and restart.
  </p>

  <ul :if={@env} class="mt-6 space-y-2 text-sm" data-testid="boot-findings">
    <li :for={problem <- @env.problems} class="flex gap-3">
      <span class="w-4 shrink-0 font-mono text-red-600 dark:text-red-400" aria-hidden="true">✗</span>
      <span class="sr-only">problem</span>
      <span class="min-w-0 break-words">
        <code class="font-semibold">{problem.variable}</code>
        <span class="ml-1 text-zinc-500">{problem.kind}</span>
        <span class="ml-1 text-zinc-700 dark:text-zinc-300">{problem.detail}</span>
      </span>
    </li>
    <li :if={database_kind(@state)} class="flex gap-3">
      <span class="w-4 shrink-0 font-mono text-green-600 dark:text-green-400" aria-hidden="true">
        ✓
      </span>
      <span class="min-w-0">
        <code class="font-semibold">DATABASE</code>
        <span class="ml-1 text-zinc-700 dark:text-zinc-300">{database_kind(@state)}</span>
      </span>
    </li>
    <li :for={warning <- @env.warnings} class="flex gap-3">
      <span class="w-4 shrink-0 font-mono text-amber-600 dark:text-amber-400" aria-hidden="true">
        ⚠
      </span>
      <span class="sr-only">warning</span>
      <span class="min-w-0 break-words">
        <code :if={warning.variable} class="font-semibold">{warning.variable}</code>
        <span class="ml-1 text-zinc-700 dark:text-zinc-300">{warning.detail}</span>
      </span>
    </li>
  </ul>

  <div :if={@paste_block && @paste_block != ""} class="mt-8">
    <h2 class="text-sm font-medium">Copy, replace the ‹…› values, set, restart:</h2>
    <pre
      class="mt-2 select-all overflow-x-auto rounded-md border border-zinc-200 bg-zinc-50 p-4 font-mono text-xs leading-relaxed dark:border-zinc-700 dark:bg-zinc-900"
      data-testid="boot-paste-block"
    >{@paste_block}</pre>
  </div>

  <dl class="mt-6 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm text-zinc-600 dark:text-zinc-400">
    <dt class="text-zinc-500">Other adapters</dt>
    <dd>{Enum.join(other_adapters(@env), " · ")}</dd>
    <dt class="text-zinc-500">Remote database</dt>
    <dd><code>DATABASE_URL</code> + <code>TURSO_AUTH_TOKEN</code></dd>
    <dt class="text-zinc-500">Where</dt>
    <dd>{platform_hint(@platform)}</dd>
  </dl>

  <div class="mt-8 border-t border-zinc-200 pt-4 dark:border-zinc-700">
    <.ground_truth state={@state} />
    <p class="mt-3 text-xs text-zinc-500">The full report is also in the container log.</p>
  </div>
</div>
