<%!-- The GET peek: a button only. The single-use token is consumed by the
     explicit POST, so a mail scanner that prefetches the emailed link
     neither burns it nor receives an operator session. --%>
<% branding = CustyardWeb.Layouts.root_branding(assigns) %>
<div
  class="min-h-screen flex items-center justify-center bg-gray-100 dark:bg-zinc-900"
  data-testid="auth-page"
>
  <div class="max-w-md w-full">
    <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md p-8">
      <div class="text-center mb-8">
        <img :if={branding.logo} src={branding.logo} alt="" class="h-12 w-auto mx-auto mb-3" />
        <h1 class="text-xl font-bold text-gray-900 dark:text-zinc-100">{branding.name}</h1>
        <p class="text-sm text-gray-500 dark:text-zinc-400 mt-1">
          {assigns[:auth_title] || "Staff sign in"}
        </p>
      </div>

      <p class="text-sm text-gray-600 dark:text-zinc-400 mb-6">
        Press the button to finish signing in. The link works once.
      </p>

      <form
        action={(assigns[:auth_base] || "/app") <> "/login/verify/" <> @token}
        method="post"
        data-testid="auth-verify-form"
      >
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

        <button
          type="submit"
          class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-zinc-800 font-medium"
          data-testid="auth-verify-submit"
        >
          Log in
        </button>
      </form>
    </div>
  </div>
</div>
