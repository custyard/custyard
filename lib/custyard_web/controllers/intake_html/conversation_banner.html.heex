<%!-- "Resume your conversation" banner: a link only, never conversation
     content. Rendered when the signed conversation cookie verified against a
     live prospect. Assigns: @conversation_path. --%>
<div
  class="mb-6 rounded-lg border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950 px-4 py-3 text-sm"
  data-testid="intake-resume-banner"
>
  <span class="text-indigo-900 dark:text-indigo-100">Already wrote to us?</span>
  <.link
    href={@conversation_path}
    class="font-medium text-indigo-700 dark:text-indigo-300 underline"
    data-testid="intake-resume-banner-link"
  >
    Resume your conversation
  </.link>
</div>
