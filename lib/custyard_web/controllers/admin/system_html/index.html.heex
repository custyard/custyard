<div class="max-w-2xl mx-auto p-4" data-testid="admin-system-page">
  <h1 class="text-lg font-semibold text-gray-900 dark:text-zinc-100 mb-6">System</h1>

  <section
    class="bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg p-4 mb-4"
    data-testid="system-boot"
  >
    <h2 class="text-sm font-semibold text-gray-900 dark:text-zinc-100 mb-3">Boot</h2>
    <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-gray-500 dark:text-zinc-400">Mode</dt>
      <dd class="font-mono text-gray-700 dark:text-zinc-300" data-testid="system-mode">
        {@state.mode}
      </dd>
    </dl>
    <div class="mt-4">
      <.ground_truth state={@state} id="system-ground-truth" />
    </div>
  </section>

  <section
    class="bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg p-4 mb-4"
    data-testid="system-first-run"
  >
    <h2 class="text-sm font-semibold text-gray-900 dark:text-zinc-100 mb-3">First run</h2>
    <ol class="space-y-2 text-sm text-gray-700 dark:text-zinc-300">
      <li :for={step <- @state.first_run.steps} class="flex gap-3" data-step={step.key}>
        <.step_glyph step={step} />
        <span>
          <span class="font-medium">{step_label(step.key)}</span>
          <span :if={step.detail} class="ml-1 text-gray-500 dark:text-zinc-400">{step.detail}</span>
        </span>
      </li>
    </ol>
    <p :if={@state.first_run.completed_at} class="mt-3 text-xs text-gray-500 dark:text-zinc-400">
      Completed {format_time(@state.first_run.completed_at)}<span :if={
        @state.first_run.instance_admin_email
      }>
        · instance administrator {@state.first_run.instance_admin_email}</span>.
    </p>
  </section>

  <section
    class="bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg p-4 mb-4"
    data-testid="system-mail"
  >
    <h2 class="text-sm font-semibold text-gray-900 dark:text-zinc-100 mb-3">
      Last outbound mail
    </h2>
    <p :if={is_nil(@state.last_mail)} class="text-sm text-gray-500 dark:text-zinc-400">
      No mail has been sent since boot.
    </p>
    <dl
      :if={@state.last_mail}
      class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm text-gray-700 dark:text-zinc-300"
    >
      <dt class="text-gray-500 dark:text-zinc-400">At</dt>
      <dd class="font-mono">{format_time(@state.last_mail.at)}</dd>
      <dt class="text-gray-500 dark:text-zinc-400">Adapter</dt>
      <dd class="font-mono">{@state.last_mail.adapter}</dd>
      <dt class="text-gray-500 dark:text-zinc-400">Status</dt>
      <dd
        class={[
          "font-mono",
          @state.last_mail.status == :ok && "text-green-700 dark:text-green-400",
          @state.last_mail.status == :error && "text-red-700 dark:text-red-400"
        ]}
        data-testid="system-mail-status"
      >
        {@state.last_mail.status}
      </dd>
      <dt :if={@state.last_mail.detail} class="text-gray-500 dark:text-zinc-400">Detail</dt>
      <dd :if={@state.last_mail.detail}>{@state.last_mail.detail}</dd>
    </dl>
  </section>

  <section
    class="bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg p-4 mb-4"
    data-testid="system-warnings"
  >
    <h2 class="text-sm font-semibold text-gray-900 dark:text-zinc-100 mb-3">
      Environment warnings
    </h2>
    <p :if={@warnings == []} class="text-sm text-gray-500 dark:text-zinc-400">
      <%= if @state.env do %>
        None.
      <% else %>
        No boot report was recorded for this process.
      <% end %>
    </p>
    <ul :if={@warnings != []} class="space-y-1 text-sm text-gray-700 dark:text-zinc-300">
      <li :for={warning <- @warnings} class="flex gap-3">
        <span class="w-4 shrink-0 font-mono text-amber-600 dark:text-amber-400" aria-hidden="true">
          ⚠
        </span>
        <span class="min-w-0 break-words">
          <code :if={warning.variable} class="font-semibold">{warning.variable}</code>
          <span class="ml-1">{warning.detail}</span>
        </span>
      </li>
    </ul>
  </section>
</div>
