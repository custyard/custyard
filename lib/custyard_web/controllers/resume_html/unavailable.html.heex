<%!-- One identical page for every resume failure class (invalid, revoked,
     purged, malformed) — no validity oracle. Keep it static. --%>
<div class="py-16 text-center" data-testid="resume-unavailable">
  <h1 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">
    Conversation unavailable
  </h1>
  <p class="mt-4 text-zinc-600 dark:text-zinc-400">
    This conversation link is not available. If you received a newer link, try that one instead.
  </p>
</div>
