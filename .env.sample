# Custyard Configuration (non-sensitive)
# Copy to .env and customize
# These values are synced to fly.toml [env] by: mix fly.secrets --apply
# NOTE: fly.toml needs to be checked in for the env vars to take effect.

# =============================================================================
# Core
# =============================================================================

# Required in production: magic-link URLs and origin checks use it. On Fly it
# falls back to FLY_APP_NAME.fly.dev.
PHX_HOST=custyard.example.com
PORT=4000
# Hosting and database choices are independent (Fly staging can use Bunny DB).
# STORAGE_PROVIDER=bunny       # local|fly|bunny; Fly auto-detected on Fly
# PROXY_PROVIDER=bunny         # none|fly|bunny; Bunny requires origin secret
# DATABASE_PROVIDER=bunny      # sqlite|turso|bunny|postgres
# See docs/ops/bunny-setup.md for CDN settings.
# Uploaded files and attachments are stored in the database. SQLite, the
# default, uses the mounted /data volume on Fly.io; a remote database needs
# no volume.
# DATABASE_PATH is unused when DATABASE_URL (.env.secrets) points at Turso.
# DATABASE_PATH=/data/custyard.db
# Only needed to import files written by earlier releases, and only when they
# are somewhere other than these defaults.
# UPLOAD_DIR=/data/uploads
# ATTACHMENT_DIR=/data/attachments

# Boot runs pending migrations. true skips them for one boot (true|false;
# anything else is a doctor-card problem).
# SKIP_MIGRATIONS=false

# Acknowledgment subscriptions and encrypted broker credentials belong to tenants
# and are configured at /app/settings/integrations. This is a process tuning knob.
ACKNOWLEDGMENTS_PREFETCH=1

# =============================================================================
# Email Ingestion (Optional - both disabled by default)
# =============================================================================

# LMTP Server - receives email from MTA (Postfix, Stalwart, Maddy)
LMTP_ENABLED=false
LMTP_PORT=2024
LMTP_HOSTNAME=localhost
# LMTP_TLS_CERTFILE=/path/to/cert.pem
# LMTP_TLS_KEYFILE=/path/to/key.pem
# LMTP_TLS_CACERTFILE=/path/to/ca.pem

# IMAP mailboxes are connected per tenant channel at /app/settings/email.

# =============================================================================
# Outbound Email
# =============================================================================

# Adapter: lettermint|postmark|sendgrid|mailgun|smtp (dev uses local capture at /dev/mailbox)
# MAIL_ADAPTER=lettermint
# Installation recovery switch: false holds all queued customer replies.
# Authentication mail remains available. Accepts only true or false.
# OUTBOUND_DELIVERY_ENABLED=true

# Mailgun
# MAILGUN_DOMAIN=mg.example.com

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_SSL=false

# Lettermint
# LETTERMINT_API_URL=https://api.lettermint.co/v1
# LETTERMINT_PROJECT_TOKEN=  # system authentication mail only
# Tenant admins save encrypted sending/management tokens at /app/settings/email.

# =============================================================================
# Email Notifications (Neglect Alerts)
# =============================================================================

# On by default unless MAIL_ADAPTER is local; set false for silence.
# EMAIL_NOTIFICATIONS_ENABLED=false
# Defaults: Custyard and noreply@PHX_HOST. The provider must verify the sender.
# EMAIL_FROM_NAME=Custyard
# EMAIL_FROM_ADDRESS=noreply@custyard.example.com

# =============================================================================
# Error Tracking (self-hosted Sentry) — non-sensitive config
# =============================================================================
# The DSN itself is a secret (see .env.secrets.sample). These are optional:
# SENTRY_ENVIRONMENT distinguishes deployments in the Sentry UI (default
# "production"); SENTRY_RELEASE groups errors by deploy (e.g. a git SHA).

# SENTRY_ENVIRONMENT=custyard-eu-prod
# SENTRY_RELEASE=
