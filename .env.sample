# Custyard Configuration (non-sensitive)
# Copy to .env and customize
# These values are synced to fly.toml [env] by: mix fly.secrets --apply
# NOTE: fly.toml needs to be checked in for the env vars to take effect.

# =============================================================================
# Core
# =============================================================================

PHX_HOST=custyard.example.com
PORT=4000
# SQLite and uploads use the mounted /data volume on Fly.io by default.
# DATABASE_PATH is unused when DATABASE_URL (.env.secrets) points at Turso.
# DATABASE_PATH=/data/custyard.db
# UPLOAD_DIR=/data/uploads

# Colonel acknowledgments are on by default in production: the consumer starts
# once both secrets in .env.secrets (ACKNOWLEDGMENTS_AMQP_URL and
# ACKNOWLEDGMENTS_SOURCE) are set. With neither set the app boots without it;
# with only one set the app refuses to boot. Unset means off in development and
# test. Uncomment to switch it off explicitly (true or false only).
# See docs/ops/acknowledgments.md.
# ACKNOWLEDGMENTS_ENABLED=false
# ACKNOWLEDGMENTS_QUEUE=custyard.acknowledgments
ACKNOWLEDGMENTS_PREFETCH=1

# =============================================================================
# Email Ingestion (Optional - both disabled by default)
# =============================================================================

# LMTP Server - receives email from MTA (Postfix, Stalwart, Maddy)
LMTP_ENABLED=false
LMTP_PORT=2024
LMTP_HOSTNAME=localhost
# LMTP_TLS_CERTFILE=/path/to/cert.pem
# LMTP_TLS_KEYFILE=/path/to/key.pem
# LMTP_TLS_CACERTFILE=/path/to/ca.pem

# IMAP mailboxes are connected per channel in the operator UI; the global
# IMAP_* settings were removed (docs/ops/inbound-channels.md).

# =============================================================================
# Outbound Email
# =============================================================================

# Adapter: mailgun|sendgrid|smtp|lettermint (dev uses local capture at /dev/mailbox)
# MAIL_ADAPTER=lettermint

# Mailgun
# MAILGUN_DOMAIN=mg.example.com

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_SSL=false

# Lettermint
# LETTERMINT_API_URL=https://api.lettermint.co/v1
# LETTERMINT_PROJECT_TOKEN=  # sending, default tenant bootstrap only
# LETTERMINT_TEAM_TOKEN=     # management, distinct from project token
# Tenant admins configure encrypted credentials and webhook bindings at /operator/email-setup.

# =============================================================================
# Email Notifications (Neglect Alerts)
# =============================================================================

# EMAIL_NOTIFICATIONS_ENABLED=true
# OPERATOR_NOTIFICATION_EMAIL=ops@example.com
# EMAIL_FROM_NAME=Custyard Alerts
# EMAIL_FROM_ADDRESS=alerts@custyard.local

# =============================================================================
# Error Tracking (self-hosted Sentry) — non-sensitive config
# =============================================================================
# The DSN itself is a secret (see .env.secrets.sample). These are optional:
# SENTRY_ENVIRONMENT distinguishes deployments in the Sentry UI (default
# "production"); SENTRY_RELEASE groups errors by deploy (e.g. a git SHA).

# SENTRY_ENVIRONMENT=custyard-eu-prod
# SENTRY_RELEASE=
