# Custyard Development Environment
# Copy to .env and customize, or export directly

# Usage:
#
#   mix fly.secrets              # Preview changes
#   mix fly.secrets --apply      # Apply to Fly.io (updates fly.toml and sets secrets)

OPERATOR_PASSWORD=
LIVE_VIEW_SIGNING_SALT=
SECRET_KEY_BASE=
LETTERMINT_API_KEY
LETTERMINT_API_URL

# =============================================================================
# Email Ingestion (Optional - both disabled by default)
# =============================================================================

# LMTP Server - receives email from MTA (Postfix, Stalwart, Maddy)
LMTP_ENABLED=false
LMTP_PORT=2024
LMTP_HOSTNAME=localhost
# LMTP_TLS_CERTFILE=/path/to/cert.pem
# LMTP_TLS_KEYFILE=/path/to/key.pem
# LMTP_TLS_CACERTFILE=/path/to/ca.pem

# IMAP Poller - polls mailbox for new messages
IMAP_ENABLED=false
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL=60000
IMAP_SSL=true


# =============================================================================
# Production Only
# =============================================================================

# Required in production
# SECRET_KEY_BASE=generate-with-mix-phx.gen.secret
# PHX_HOST=custyard.example.com
# PORT=4000
# DATABASE_URL=

# Outbound email (development uses local capture at /dev/mailbox)
# MAIL_ADAPTER=mailgun|sendgrid|smtp|lettermint

# Mailgun
# MAILGUN_API_KEY=key-xxx
# MAILGUN_DOMAIN=mg.example.com

# SendGrid
# SENDGRID_API_KEY=SG.xxx

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SSL=false

# Lettermint (outbound)
#
# MAIL_ADAPTER=lettermint
# LETTERMINT_API_TOKEN=your-api-token
# LETTERMINT_API_URL=https://api.lettermint.co/v1

# Inbound webhooks (Lettermint or other providers)
# Configure provider to POST to: https://your-host/webhook/inbound
# WEBHOOK_TOKEN=shared-secret-for-webhook-auth

# =============================================================================
# Email Notifications (Neglect Alerts)
# =============================================================================

# Enable email notifications for neglect alerts and system events
# EMAIL_NOTIFICATIONS_ENABLED=true

# Recipient for operator notifications (neglect alerts, system events)
# OPERATOR_NOTIFICATION_EMAIL=ops@example.com

# Sender identity for notification emails
# EMAIL_FROM_NAME=Custyard Alerts
# EMAIL_FROM_ADDRESS=alerts@custyard.local
