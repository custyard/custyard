#!/usr/bin/env bash

# bin/fly-secrets - Set Fly.io secrets from .env file
#
# USAGE:
#   $ bin/fly-secrets                    # Preview secrets that would be set
#   $ bin/fly-secrets --apply            # Actually set the secrets
#   $ bin/fly-secrets --stage            # Set secrets without redeploying
#   $ bin/fly-secrets -a other-app       # Target a different app
#
# SECRETS (set via fly secrets, never in fly.toml):
#   SECRET_KEY_BASE, LIVE_VIEW_SIGNING_SALT, OPERATOR_PASSWORD,
#   DATABASE_URL, TURSO_AUTH_TOKEN, LETTERMINT_API_TOKEN, WEBHOOK_TOKEN,
#   MAILGUN_API_KEY, SENDGRID_API_KEY, SMTP_PASSWORD, IMAP_PASSWORD
#
# NON-SECRETS (safe for fly.toml [env] section):
#   PHX_HOST, PORT, MAIL_ADAPTER, LMTP_ENABLED, IMAP_ENABLED, etc.

set -euo pipefail

# Secrets that should be set via fly secrets (contain sensitive data)
SECRET_VARS=(
  SECRET_KEY_BASE
  LIVE_VIEW_SIGNING_SALT
  OPERATOR_PASSWORD
  DATABASE_URL
  TURSO_AUTH_TOKEN
  LETTERMINT_API_TOKEN
  WEBHOOK_TOKEN
  MAILGUN_API_KEY
  SENDGRID_API_KEY
  POSTMARK_API_KEY
  SMTP_PASSWORD
  IMAP_PASSWORD
)

ENV_FILE="${ENV_FILE:-.env}"
APP_NAME=""
APPLY=false
STAGE=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)
      APPLY=true
      shift
      ;;
    --stage)
      APPLY=true
      STAGE=true
      shift
      ;;
    -a|--app)
      APP_NAME="$2"
      shift 2
      ;;
    -a=*|--app=*)
      APP_NAME="${1#*=}"
      shift
      ;;
    -h|--help)
      head -20 "$0" | tail -19
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: $ENV_FILE not found" >&2
  echo "Copy .env.sample to .env and fill in values" >&2
  exit 1
fi

# Build app flag
APP_FLAG=""
if [[ -n "$APP_NAME" ]]; then
  APP_FLAG="-a $APP_NAME"
fi

# Extract secrets from .env
extract_secrets() {
  local secrets=""

  for var in "${SECRET_VARS[@]}"; do
    # Match VAR=value (not commented, not empty value)
    value=$(grep -E "^${var}=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2-)

    if [[ -n "$value" ]]; then
      # Strip surrounding quotes if present
      value="${value#\"}"
      value="${value%\"}"
      value="${value#\'}"
      value="${value%\'}"

      if [[ -n "$value" ]]; then
        secrets+="${var}=${value}"$'\n'
      fi
    fi
  done

  echo -n "$secrets"
}

secrets=$(extract_secrets)

if [[ -z "$secrets" ]]; then
  echo "No secrets found in $ENV_FILE"
  echo "Expected variables: ${SECRET_VARS[*]}"
  exit 0
fi

# Count secrets
count=$(echo -n "$secrets" | grep -c '^' || true)

if [[ "$APPLY" == "true" ]]; then
  echo "Setting $count secret(s)..."

  stage_flag=""
  if [[ "$STAGE" == "true" ]]; then
    stage_flag="--stage"
    echo "(Staging only - no redeploy)"
  fi

  # shellcheck disable=SC2086
  echo -n "$secrets" | fly secrets import $APP_FLAG $stage_flag

  echo "Done."
else
  echo "Preview: $count secret(s) would be set:"
  echo ""
  echo "$secrets" | while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      var="${line%%=*}"
      value="${line#*=}"
      # Mask the value
      if [[ ${#value} -gt 8 ]]; then
        masked="${value:0:4}...${value: -4}"
      else
        masked="****"
      fi
      echo "  $var=$masked"
    fi
  done
  echo ""
  echo "Run with --apply to set secrets, or --stage to set without redeploying"
fi
