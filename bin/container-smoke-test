#!/usr/bin/env bash
# Exercise the loaded Linux image with disposable volumes and no external network.
# Usage: bin/container-smoke-test [image] (default: custyard:test)
set -euo pipefail

image=${1:-custyard:test}
run_id="custyard-smoke-$$-${RANDOM}"
label="custyard.smoke-test=$run_id"
data_volume="$run_id-data"
backup_volume="$run_id-backup"
app_volume="$run_id-app"
app="$run_id-app"
work=$(mktemp -d)
origin_secret="isolated-container-smoke-origin-secret-32-bytes"
common=(-e SECRET_KEY_BASE=isolated-container-smoke-secret-key-base-at-least-sixty-four-bytes-long
  -e MAIL_ADAPTER=local -e ACKNOWLEDGMENTS_ENABLED=false -e LMTP_ENABLED=false)
bunny=(-e DATABASE_PROVIDER=bunny -e BUNNY_DATABASE_URL=https://database.invalid
  -e BUNNY_DATABASE_AUTH_TOKEN=isolated-smoke-token -e STORAGE_PROVIDER=bunny
  -e DATA_VOLUME_ID=isolated-smoke-volume -e MAINTENANCE_MODE=true)
mounts=(-v "$data_volume:/data" -v "$backup_volume:/backup")

cleanup() {
  local containers container
  containers=$(timeout 10 docker ps -aq --filter "label=$label") || containers=""
  while IFS= read -r container; do
    if [ -n "$container" ]; then timeout 10 docker rm -f "$container" >/dev/null 2>&1 || true; fi
  done <<< "$containers"
  timeout 10 docker volume rm "$data_volume" "$backup_volume" "$app_volume" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
run() { timeout 60 docker run --rm --network none --label "$label" "${common[@]}" "$@"; }
expect_failure() {
  local expected=$1
  shift
  if "$@" >"$work/failure.log" 2>&1; then echo "Expected failure: $expected" >&2; exit 1; fi
  if ! grep -Fq "$expected" "$work/failure.log"; then cat "$work/failure.log" >&2; exit 1; fi
}

timeout 10 docker image inspect "$image" >/dev/null
for volume in "$data_volume" "$backup_volume" "$app_volume"; do
  timeout 10 docker volume create --label "$label" "$volume" >/dev/null
done
# A mount hides image ownership. Prepare it explicitly, then run every check as
# the image's normal custyard user, including the release volume commands.
run --user root "${mounts[@]}" -v "$app_volume:/test-app" --entrypoint /bin/sh "$image" \
  -ec 'chown custyard:custyard /data /backup /test-app'

echo "==> initialize and verify the mounted Bunny file volume without a database connection"
run "${bunny[@]}" "${mounts[@]}" --entrypoint /app/bin/data-volume "$image" init
run "${bunny[@]}" "${mounts[@]}" --entrypoint /app/bin/data-volume "$image" init
run "${bunny[@]}" "${mounts[@]}" --entrypoint /app/bin/custyard "$image" eval 'Custyard.Storage.validate!()'
expect_failure 'File-volume marker is missing or does not match' \
  run "${bunny[@]}" "${mounts[@]}" -e DATA_VOLUME_ID=wrong-volume \
  --entrypoint /app/bin/custyard "$image" eval 'Custyard.Storage.validate!()'
expect_failure 'Bunny requires a mounted file volume' \
  run "${bunny[@]}" --entrypoint /app/bin/custyard "$image" eval 'Custyard.Storage.validate!()'

echo "==> back up and restore files through the shipped release overlay"
run "${mounts[@]}" --entrypoint /bin/sh "$image" \
  -ec 'printf logo > /data/uploads/logo; printf private-mail > /data/attachments/mail'
run "${bunny[@]}" "${mounts[@]}" --entrypoint /app/bin/data-volume "$image" backup /backup/snapshot
run "${mounts[@]}" --entrypoint /bin/sh "$image" -ec 'rm /data/uploads/logo /data/attachments/mail'
run "${bunny[@]}" "${mounts[@]}" --entrypoint /app/bin/data-volume "$image" restore /backup/snapshot
run "${mounts[@]}" --entrypoint /bin/sh "$image" \
  -ec 'grep -qx logo /data/uploads/logo; grep -qx private-mail /data/attachments/mail'

echo "==> boot entrypoint migrations and Bunny proxy guard against isolated SQLite"
timeout 60 docker run -d --network none --label "$label" --name "$app" "${common[@]}" \
  -v "$app_volume:/data" -e DATABASE_PROVIDER=sqlite -e STORAGE_PROVIDER=local \
  -e PROXY_PROVIDER=bunny -e BUNNY_ORIGIN_SECRET="$origin_secret" \
  -e PHX_HOST=smoke.example -e OPERATOR_EMAIL=operator@example.test "$image" >/dev/null
healthy=false
for _ in $(seq 1 60); do
  if timeout 10 docker exec "$app" curl -fsS --connect-timeout 1 --max-time 3 \
    http://127.0.0.1:4000/api/health >/dev/null 2>&1; then healthy=true; break; fi
  if [ "$(timeout 10 docker inspect --format '{{.State.Running}}' "$app")" != true ]; then break; fi
  sleep 1
done
if [ "$healthy" != true ]; then timeout 10 docker logs "$app" >&2; exit 1; fi

request() {
  local request_path=$1
  shift
  timeout 10 docker exec "$app" curl -sS --connect-timeout 1 --max-time 5 \
    -o /tmp/smoke-body -D /tmp/smoke-headers -w '%{http_code}' "$@" \
    "http://127.0.0.1:4000$request_path"
}
expect_status() {
  local expected=$1 request_path=$2 actual
  shift 2
  actual=$(request "$request_path" "$@")
  if [ "$actual" != "$expected" ]; then
    echo "Expected HTTP $expected for $request_path, got $actual" >&2; timeout 10 docker logs "$app" >&2; exit 1
  fi
}
for route in /favicon.ico /operator/login '/live/websocket?vsn=2.0.0' '/live/longpoll?vsn=2.0.0' '/api/health?extra=1'; do
  expect_status 403 "$route"
done
expect_status 200 /api/health
expect_status 200 /operator/login -H 'Host: smoke.example' -H "X-Custyard-Origin: $origin_secret" \
  -H 'X-Forwarded-Proto: https' -H 'X-Forwarded-Port: 1234' -H 'X-Forwarded-Host: spoofed.invalid'
timeout 10 docker exec "$app" grep -Fiq 'strict-transport-security: max-age=31536000' /tmp/smoke-headers
expect_status 301 /operator/login -H 'Host: tenant.smoke.example' -H "X-Custyard-Origin: $origin_secret" \
  -H 'X-Forwarded-Proto: http' -H 'X-Forwarded-Host: spoofed.invalid'
timeout 10 docker exec "$app" grep -Fiq 'location: https://tenant.smoke.example/operator/login' /tmp/smoke-headers
timeout 30 docker stop --timeout 20 "$app" >/dev/null
case $(docker inspect --format '{{.State.ExitCode}}' "$app") in
  0|143) ;;
  *) echo 'Container did not stop cleanly within its grace period' >&2; exit 1 ;;
esac
echo "container smoke test passed"
