#!/usr/bin/env bash

# bin/release-smoke-test - Boot the built release and provision operators
# against it the way the entrypoint and operators do.
#
# USAGE:
#   $ MIX_ENV=prod mix release
#   $ bin/release-smoke-test [path/to/bin/custyard]
#
# Guards Custyard.Release.setup_operator/1: it must start only the Repo. If it
# starts the application, `bin/custyard eval` on a running machine (the
# documented `fly ssh console` command) brings up a second Endpoint, which
# fails to bind the port the server holds.
#
# Uses a throwaway SQLite database and MAIL_ADAPTER=local.
# Env: PORT (default 4099).

set -euo pipefail

rel=${1:-_build/prod/rel/custyard/bin/custyard}

if [ ! -x "$rel" ]; then
  echo "release not found at $rel (build it with: MIX_ENV=prod mix release)" >&2
  exit 1
fi

work=$(mktemp -d)
server_pid=""

cleanup() {
  if [ -n "$server_pid" ]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "$work"
}
trap cleanup EXIT

SECRET_KEY_BASE=$(openssl rand -hex 64)
export SECRET_KEY_BASE
export MAIL_ADAPTER=local
export PHX_HOST=localhost
export PORT=${PORT:-4099}
export DATABASE_PATH="$work/custyard.db"
export UPLOAD_DIR="$work/uploads"
mkdir -p "$UPLOAD_DIR"

health="http://localhost:$PORT/api/health"

step() { echo "==> $*"; }

step "migrate and provision before the server starts (entrypoint.sh order)"
"$rel" eval 'Custyard.Release.migrate()'
"$rel" eval 'Custyard.Release.setup_operator()'

# Otherwise the health checks below could be answered by that process while
# our server dies on :eaddrinuse.
if curl -s -o /dev/null "http://localhost:$PORT/" 2>/dev/null; then
  echo "something is already listening on port $PORT; set PORT to a free port" >&2
  exit 1
fi

step "start the server on port $PORT"
"$rel" start >"$work/server.log" 2>&1 &
server_pid=$!

for _ in $(seq 1 60); do
  curl -fsS "$health" >/dev/null 2>&1 && break
  sleep 1
done

if ! curl -fsS "$health" >/dev/null 2>&1 || ! kill -0 "$server_pid" 2>/dev/null; then
  echo "server did not come up on port $PORT:" >&2
  cat "$work/server.log" >&2
  exit 1
fi

step "provision while the server holds the port"
"$rel" eval 'Custyard.Release.setup_operator(" Ops@Example.COM ")'
"$rel" eval 'Custyard.Release.setup_operator("OPS@example.com")'

step "check the stored accounts"
"$rel" eval '
  import Ecto.Query

  {:ok, emails, _} =
    Ecto.Migrator.with_repo(Custyard.Repo, fn repo ->
      repo.all(from o in "operator_accounts", select: o.email, order_by: o.email)
    end)

  expected = ["admin@custyard.local", "ops@example.com"]
  emails == expected || raise "expected #{inspect(expected)}, got #{inspect(emails)}"
'

step "server still serving"
kill -0 "$server_pid"
curl -fsS "$health" >/dev/null

echo "release smoke test passed"
