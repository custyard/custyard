#!/usr/bin/env bash

# bin/release-smoke-test - Boot the built release and provision operators
# against it the way the entrypoint and operators do.
#
# USAGE:
#   $ MIX_ENV=prod mix release
#   $ bin/release-smoke-test [path/to/bin/custyard]
#
# Guards the Custyard.Release tasks (the OPERATOR_EMAIL bootstrap,
# setup_operator and bin/operator): they must start only the Repo. If one
# starts the application, running it on a live machine (the documented
# `fly ssh console` commands) brings up a second Endpoint, which fails to
# bind the port the server holds.
#
# Uses a throwaway SQLite database, or the empty database at DATABASE_URL
# when set (CI runs it again against a libSQL server), and MAIL_ADAPTER=local.
# Env: PORT (default 4099).

set -euo pipefail

rel=${1:-_build/prod/rel/custyard/bin/custyard}
operator="$(dirname "$rel")/operator"

if [ ! -x "$rel" ] || [ ! -x "$operator" ]; then
  echo "release not found at $rel (build it with: MIX_ENV=prod mix release)" >&2
  exit 1
fi

work=$(mktemp -d)
server_pid=""

cleanup() {
  if [ -n "$server_pid" ]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "$work"
}
trap cleanup EXIT

SECRET_KEY_BASE=$(openssl rand -hex 64)
export SECRET_KEY_BASE
export MAIL_ADAPTER=local
export PHX_HOST=localhost
export PORT=${PORT:-4099}
if [ -z "${DATABASE_URL:-}" ]; then
  export DATABASE_PATH="$work/custyard.db"
fi
export UPLOAD_DIR="$work/uploads"
mkdir -p "$UPLOAD_DIR"

health="http://localhost:$PORT/api/health"

# Bounded, so a listener that accepts and never answers cannot hang the run.
curl_opts=(--connect-timeout 2 --max-time 5)

step() { echo "==> $*"; }

step "migrate and bootstrap OPERATOR_EMAIL before the server starts (entrypoint.sh)"
OPERATOR_EMAIL=" Boot@Example.COM " \
  "$rel" eval '
    require Logger
    app_started? = fn -> Enum.any?(Application.started_applications(), fn {app, _, _} -> app == :custyard end) end
    false = app_started?.()
    Custyard.Release.migrate()
    true = List.keymember?(:logger.get_primary_config()[:filters], :custyard_log_privacy, 0)
    {:ok, %{formatter: {Custyard.Log.Formatter, _}}} = :logger.get_handler_config(:default)
    Logger.error("RELEASE_BOOT_PRIVATE_CANARY")
    Custyard.Release.bootstrap_operator()
    Logger.flush()
    false = app_started?.()
  ' >"$work/bootstrap.log" 2>&1

if grep -q 'RELEASE_BOOT_PRIVATE_CANARY' "$work/bootstrap.log"; then
  echo "release eval leaked a raw diagnostic before server startup" >&2
  exit 1
fi
if ! grep -Fq '"event":"external_log"' "$work/bootstrap.log" ||
   ! grep -Fq '"event":"operator_account_created"' "$work/bootstrap.log"; then
  echo "release eval did not emit expected structured privacy-safe events:" >&2
  cat "$work/bootstrap.log" >&2
  exit 1
fi
cat "$work/bootstrap.log"

step "migration and rollback failures exit nonzero with sanitized exceptions"
for task in migrate rollback; do
  if "$rel" eval '
    defmodule ReleasePrivacyProbeRepo do
      def config, do: raise("RELEASE_TASK_PRIVATE_CANARY")
    end
    Application.load(:custyard)
    System.delete_env("FLY_APP_NAME")
    Application.put_env(:custyard, :ecto_repos, [ReleasePrivacyProbeRepo])
    case System.argv() do
      ["migrate"] -> Custyard.Release.migrate()
      ["rollback"] -> Custyard.Release.rollback(ReleasePrivacyProbeRepo, 1)
    end
  ' "$task" >"$work/$task-failure.log" 2>&1; then
    echo "release $task unexpectedly succeeded with a failing repository" >&2
    exit 1
  fi
  if grep -q 'RELEASE_TASK_PRIVATE_CANARY' "$work/$task-failure.log"; then
    echo "release $task leaked private exception content" >&2
    exit 1
  fi
  grep -Eq '"event":"release_(migration|rollback)_failed"' "$work/$task-failure.log"
  grep -Eq 'Database (migration|rollback) failed; see structured diagnostics' "$work/$task-failure.log"
done

step "bootstrap failure exits nonzero without raw input or exception output"
if OPERATOR_EMAIL="RELEASE_BOOT_FAILURE_PRIVATE_CANARY" \
  "$rel" eval 'Custyard.Release.bootstrap_operator()' >"$work/bootstrap-failure.log" 2>&1; then
  echo "invalid operator bootstrap unexpectedly succeeded" >&2
  exit 1
fi
if grep -q 'RELEASE_BOOT_FAILURE_PRIVATE_CANARY' "$work/bootstrap-failure.log"; then
  echo "operator bootstrap leaked private failure content" >&2
  exit 1
fi
grep -Fq '"event":"operator_bootstrap_failed"' "$work/bootstrap-failure.log"
grep -Fq '"reason":"validation_failed"' "$work/bootstrap-failure.log"
grep -Fq '"validation_fields":["email"]' "$work/bootstrap-failure.log"
grep -Fq 'OPERATOR_EMAIL: operator bootstrap failed; see structured diagnostics' "$work/bootstrap-failure.log"

# curl exits 7 only when the connection is refused. Anything else, a reply or
# a listener that accepts and never answers, means the port is taken, and the
# health checks below could be answered by that process while our server dies
# on :eaddrinuse.
rc=0
curl -s -o /dev/null "${curl_opts[@]}" "http://localhost:$PORT/" 2>/dev/null || rc=$?
if [ "$rc" -ne 7 ]; then
  echo "port $PORT is in use (curl exit $rc); set PORT to a free port" >&2
  exit 1
fi

step "start the server on port $PORT"
"$rel" start >"$work/server.log" 2>&1 &
server_pid=$!

for _ in $(seq 1 60); do
  curl -fsS "${curl_opts[@]}" "$health" >/dev/null 2>&1 && break
  sleep 1
done

if ! curl -fsS "${curl_opts[@]}" "$health" >/dev/null 2>&1 || ! kill -0 "$server_pid" 2>/dev/null; then
  echo "server did not come up on port $PORT:" >&2
  cat "$work/server.log" >&2
  exit 1
fi

step "provision while the server holds the port"
"$rel" eval 'Custyard.Release.setup_operator(" Ops@Example.COM ")'
"$rel" eval 'Custyard.Release.setup_operator("OPS@example.com")'
"$operator" add Second@Example.COM
listing=$("$operator" list)
grep -q 'second@example.com' <<<"$listing" || {
  echo "bin/operator list did not show second@example.com:" >&2
  echo "$listing" >&2
  exit 1
}
"$operator" remove second@example.com

step "check the stored accounts"
"$rel" eval '
  import Ecto.Query

  {:ok, emails, _} =
    Ecto.Migrator.with_repo(Custyard.Repo, fn repo ->
      repo.all(from o in "operator_accounts", select: o.email, order_by: o.email)
    end)

  expected = ["boot@example.com", "ops@example.com"]
  emails == expected || raise "expected #{inspect(expected)}, got #{inspect(emails)}"
'

step "server still serving"
kill -0 "$server_pid"
curl -fsS "${curl_opts[@]}" "$health" >/dev/null

echo "release smoke test passed"
